---
import "../../styles/global.css";
import ParticleSystemScene from "../../components/three/ParticleSystem";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>パーティクルシステム | Three.js サンプル集</title>
  </head>
  <body class="min-h-screen flex flex-col bg-[#020409] text-slate-100">
    <header class="flex items-center gap-4 border-b border-white/10 bg-black/20 px-6 py-4 backdrop-blur-sm">
      <a href="/" class="text-sm text-slate-400 transition-colors hover:text-slate-100">
        ← サンプル一覧へ
      </a>
      <h1 class="text-lg font-semibold text-slate-50">パーティクルシステム</h1>
    </header>
    <main class="flex-1">
      <div class="h-[calc(100vh-57px)] w-full bg-cover bg-center bg-no-repeat bg-[url('/images/sample_pic.jpg')] relative">
        <h2 class="text-3xl lg:text-6xl font-bold font-sans absolute top-1/2 transform -translate-y-1/2 left-8 lg:left-14 leading-10 lg:leading-20 tracking-wider z-99">選ばれる“理由”がある<br>Web制作へ。</h2>
        <ParticleSystemScene client:only="react" />
      </div>
    </main>
  </body>
</html>
